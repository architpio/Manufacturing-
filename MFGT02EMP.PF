                R MFG1EMP
                  EMPID          6P 0       COLHDG('EMPLOYEE ID')
                                            TEXT('UNIQUE EMPLOYEE ID')
                  EMPNAM        30A         COLHDG('EMPLOYEE NAME')
                                            TEXT('EMPLOYEE FULL NAME')
                  EMPPASS       20A         COLHDG('EMPLOYEE PASSWORD')
                                            TEXT('LOGIN PASSWORD')
                  EMPCON        10P 0       COLHDG('EMPLOYEE CONTACT NO')
                                            TEXT('EMPLOYEE CONTACT NO')
                  EMPGEN         1A         COLHDG('EMPLOYEE GENDER')
                                            TEXT('EMPLOYEE GENDER')
                  EMPDEL         1A         COLHDG('EMPLOYEE DELETE')
                                            TEXT('DELETE INDICATOR')
                  EMPTYP         1A         COLHDG('EMPLOYEE ROLE')
                                            TEXT('EMPLOYEE TYPE OR ROLE')
                  EMPSTA         1A         COLHDG('EMPLOYEE STATUS')
                                            TEXT('ACTIVE OR INACTIVE')
                  EMPEMA        20A         COLHDG('EMPLOYEE EMAIL')
                                            TEXT('EMPLOYEE EMAIL')
                  EMPAGE         2P 0       COLHDG('EMPLOYEE AGE')
                                            TEXT('EMPLOYEE AGE')
                  EMPDOB        10A         COLHDG('EMPLOYEE DOB')
                                            TEXT('DATE OF BIRTH')
                  EMPDOJ        10A         COLHDG('EMPLOYEE DATEOFJOIN')
                                            TEXT('EMPLOYEE STATUS DESCRIPTION')
                  EMPSTAT       20A         COLHDG('EMPLOYEE STATE')
                                            TEXT('STATE NAME')
                  EMPPIN         6P 0       COLHDG('EMPLOYEE PINCODE')
                                            TEXT('RESIDENTIAL PINCODE')
                K EMPID