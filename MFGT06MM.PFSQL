
 CREATE TABLE ARCHIT2/MFG06MM (
     MMID     DECIMAL(6)   NOT NULL,
     PRIMARY KEY(MMID),
     MMWOID   DECIMAL(6)   NOT NULL,
     MMCPID   DECIMAL(6)   NOT NULL,
     MMQTY    DECIMAL(6)   NOT NULL,
     MMTYPE   CHAR(8)        NOT NULL,
     MMDATE   DATE           NOT NULL,
     MMSTAT   CHAR(1)        NOT NULL
 )
     RCDFMT MFG5MM;
     LABEL ON COLUMN ARCHIT2/MFG06MM
     (
         MMID   IS 'MATERIAL MOVEMENT ID',
         MMWOID IS 'WORK ORDER ID',
         MMCPID IS 'COMPONENT PRODUCT ID',
         MMQTY  IS 'MATERIAL QUANTITY',
         MMTYPE IS 'MOVEMENT TYPE',
         MMDATE IS 'MOVEMENT DATE',
         MMSTAT IS 'MOVEMENT STATUS'
        );

      LABEL ON COLUMN ARCHIT2/MFG06MM
      (
          MMID   TEXT IS 'UNIQUE MATERIAL MOVEMENT TRANSACTION ID',
          MMWOID TEXT IS 'WORK ORDER REFERENCE ID',
          MMCPID TEXT IS 'COMPONENT OR PRODUCT ID',
          MMQTY  TEXT IS 'ISSUED OR RECEIVED QUANTITY',
          MMTYPE TEXT IS 'ISSUE OR RECEIVE INDICATOR',
          MMDATE TEXT IS 'TRANSACTION DATE',
          MMSTAT TEXT IS 'TRANSACTION STATUS'
        );