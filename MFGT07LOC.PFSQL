 CREATE TABLE ARCHIT2/MFG07LO (
     LOID     DECIMAL(6)   NOT NULL,
      PRIMARY KEY(LOID),
     LONA     CHAR(30)       NOT NULL,
     LOSTAT   CHAR(1)        NOT NULL,
     LOPIN    DECIMAL(6)   NOT NULL,
     LOSTATE  CHAR(30)       NOT NULL
 )
   RCDFMT MFG7LO;

   LABEL ON COLUMN ARCHIT2/MFG07LO
   (
       LOID    IS 'LOCATION ID',
       LONA    IS 'LOCATION NAME',
       LOSTAT  IS 'LOCATION STATUS',
       LOPIN   IS 'PIN CODE',
       LOSTATE IS 'STATE'
   ) ;

   LABEL ON COLUMN ARCHIT2/MFG07LO
   (
       LOID    TEXT IS 'UNIQUE LOCATION IDENTIFIER',
       LONA    TEXT IS 'LOCATION NAME',
       LOSTAT  TEXT IS 'ACTIVE OR INACTIVE STATUS',
       LOPIN   TEXT IS 'POSTAL PIN CODE',
       LOSTATE TEXT IS 'STATE NAME'
   );